# Copy these variable NAMES into Render's dashboard (Environment tab).
# Never commit real values to Git - this file is just a reference of what's needed.
# (This replaces the earlier Node/Express prototype's env vars - kept the real
# OAuth client ID below since it was already created in Google Cloud Console.)

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com

# Database (Render gives you this automatically as DATABASE_URL when you
# attach a Postgres instance to this service - no manual entry needed there)
DATABASE_URL=postgres://user:password@host:5432/dbname

# From Google Cloud Console > APIs & Services > Credentials (OAuth client) -
# this is the real client ID already created, only the secret is withheld here
GOOGLE_OAUTH_CLIENT_ID=238822472287-g26hj3sp1qa7rd7evmet628jvoa0drfm.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=paste-the-real-secret-directly-into-Render-not-here
GOOGLE_OAUTH_REDIRECT_URI=https://YOUR-RENDER-URL.onrender.com/auth/google/callback
ALLOWED_LOGIN_DOMAIN=ravasco.com

# Service account (Drive read access, distinct from the OAuth client above).
# On Render, upload the JSON key as a "Secret File" and point this at its
# mounted path (Render mounts secret files under /etc/secrets/<filename>).
# Locally it lives at secrets/service_account.json (gitignored, never commit it).
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=secrets/service_account.json

# Drive folder IDs (existing Purchase Tracker Drive structure)
DRIVE_HRS_ROOT=1mmZrMukdhuYyHQGEfH6ci_LIiNOEQ8Qp
DRIVE_RTP_ACHHAD_ROOT=1mviBKPDyZLVLfGVZ780BX_xPR9fLxdtH
DRIVE_RTP_VAPI_ROOT=1kzWf8sf9UfXBG34WalJxgu7djX5fwNUU

# Dedicated Drive folder used to hand off new-PO extraction batches to/from
# the Claude scheduled task (request files in, result files out). Created
# 2026-08-01 as a subfolder of "Purchase Orders HO" (already shared with the
# service account, so no extra sharing step needed - it inherits access).
DRIVE_EXTRACTION_QUEUE_FOLDER=1qrXHPEAHvvRAJNXY6EzEBNW0f7Jq_IlU

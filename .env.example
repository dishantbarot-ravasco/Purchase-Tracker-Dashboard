DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Either a full postgres:// URL, or the discrete PG* vars below.
# Note for `docker compose up` (see CLAUDE.md's "Docker (local dev)"):
# docker-compose.yml sets DATABASE_URL itself, pointed at its own `db`
# service by name rather than `localhost` - the values below are only used
# when running `uv run ...` directly against a locally-installed Postgres,
# outside Docker. You don't need to change PGHOST to "db" here for Docker to
# work; leave this file as-is for the non-Docker flow.
DATABASE_URL=
PGDATABASE=purchase_tracker
PGUSER=postgres
PGPASSWORD=
PGHOST=localhost
PGPORT=5432

# Google service account for unattended Drive/Sheets access (sync jobs run
# with no human/Claude session in the loop). Share the relevant Drive
# folders/files with this service account's email, then point ONE of the
# two vars below at its key - never both:
#   - GOOGLE_SERVICE_ACCOUNT_JSON: the full JSON content as ONE line (handy
#     on Render as a single env var). Do NOT paste the file's pretty-printed
#     multi-line content here - .env is parsed one KEY=VALUE per line, so a
#     multi-line paste breaks every line that follows it.
#   - GOOGLE_SERVICE_ACCOUNT_FILE: a path to the key file on disk. Leave it
#     UNQUOTED (python-dotenv applies backslash-escape processing inside
#     double-quoted values, so a Windows path like C:\...\secrets\ravasco...
#     gets "\r" silently read as a carriage-return escape and corrupted -
#     confirmed hitting this in practice). No quotes needed anyway since
#     Windows paths under a user's home directory rarely contain spaces.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# PO master CSV lives in this folder; MIR/Stock live in a different one -
# confirmed by inspecting the real files, not a guess. Sharing the parent
# "Purchase HO" folder as Viewer covers both automatically since Drive
# permissions cascade to subfolders.
PURCHASE_TRACKER_DB_FOLDER_ID=17cP2suZv26IAU5mqSKyC8U9zL0EysF9a
HRS_MIR_STOCK_FOLDER_ID=1mmZrMukdhuYyHQGEfH6ci_LIiNOEQ8Qp
ACHHAD_MIR_STOCK_FOLDER_ID=1mviBKPDyZLVLfGVZ780BX_xPR9fLxdtH
VAPI_MIR_STOCK_FOLDER_ID=1kzWf8sf9UfXBG34WalJxgu7djX5fwNUU

# ── Auth: device-aware 2FA (email OTP + JWT-in-httpOnly-cookie) ────────────
# Only an @<this domain> email may ever have a PTUser account or log in.
ALLOWED_EMAIL_DOMAIN=ravasco.com

# Signs JWT access/refresh tokens. Defaults to DJANGO_SECRET_KEY if unset,
# but SECRET_KEY also signs Django's session/CSRF tokens - set this
# independently in production so a leak in one context doesn't compromise
# the other. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SIGNING_KEY=

# SMTP - used to send the login OTP / new-device notification emails.
# Port 465 = SSL | Port 587 = STARTTLS. Leave blank in local dev: DEBUG mode
# falls back to printing the OTP to the console instead of failing login.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Google OAuth 2.0 ("Sign in with Google") — a SEPARATE concern from the
# GOOGLE_SERVICE_ACCOUNT_* vars above: this is a human-login OAuth client,
# not the Drive service account. Create one in Google Cloud Console
# (OAuth client ID, type "Web application"), authorized redirect URI
# matching GOOGLE_OAUTH_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback/
